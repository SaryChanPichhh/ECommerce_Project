{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Bypass CORS, Port 9000)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome",
        "--web-hostname=localhost",
        "--web-port=9000",
        "--web-browser-flag=--disable-web-security",
        "--web-browser-flag=--user-data-dir=C:/temp/flutter_chrome_user"
      ]
    },
    {
      "name": "Flutter (Pixel 8 Emulator)",
      "request": "launch",
      "type": "dart",
      "deviceId": "Pixel_8"
    },
    {
      "name": "Flutter (Auto / Default)",
      "request": "launch",
      "type": "dart"
    }
  ]
}
